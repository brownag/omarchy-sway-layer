#!/usr/bin/env bash
set -euo pipefail

[[ $# == 2 ]] || exit 2
mode=$1
direction=$2
case $mode in
    lua|plain) ;;
    *) exit 2 ;;
esac
case $direction in
    l) movement_direction=left; expected_orientation=x ;;
    r) movement_direction=right; expected_orientation=x ;;
    u) movement_direction=up; expected_orientation=y ;;
    d) movement_direction=down; expected_orientation=y ;;
    *) exit 2 ;;
esac

plain_move() {
    hyprctl dispatch movewindow "$direction"
}

swap_window() {
    if [[ $mode == lua ]]; then
        hyprctl dispatch "hl.dsp.window.swap({ direction = \"$direction\" })"
    else
        hyprctl dispatch swapwindow "$direction"
    fi
}

toggle_pair_split() {
    if [[ $mode == lua ]]; then
        hyprctl dispatch 'hl.dsp.layout("togglesplit")'
    else
        hyprctl dispatch layoutmsg togglesplit
    fi
}

if ! active=$(hyprctl -j activewindow 2>/dev/null); then
    if [[ $mode == lua ]]; then swap_window; else plain_move; fi
    exit $?
fi
if ! clients=$(hyprctl -j clients 2>/dev/null); then
    if [[ $mode == lua ]]; then swap_window; else plain_move; fi
    exit $?
fi

# A clear pair is exactly two visible, ungrouped tiled clients on the workspace.
# Any additional, hidden, unmapped, grouped, or ambiguous tiled state fails closed.
decision=$(jq -cer --argjson active "$active" --arg direction "$direction" '
  def grouped: ((.grouped // []) | length) > 0 or (.group != null);
  def x_pair($a; $b):
    (($a.at[0] + $a.size[0] <= $b.at[0]) or ($b.at[0] + $b.size[0] <= $a.at[0])) and
    ([ $a.at[1], $b.at[1] ] | max) < ([ $a.at[1] + $a.size[1], $b.at[1] + $b.size[1] ] | min);
  def y_pair($a; $b):
    (($a.at[1] + $a.size[1] <= $b.at[1]) or ($b.at[1] + $b.size[1] <= $a.at[1])) and
    ([ $a.at[0], $b.at[0] ] | max) < ([ $a.at[0] + $a.size[0], $b.at[0] + $b.size[0] ] | min);
  ($active.address) as $address |
  ($active | grouped) as $active_grouped |
  if $active_grouped then {action: "out"}
  else
    ($active.workspace.id) as $workspace_id |
    [ .[] | select(.workspace.id == $workspace_id) ] as $workspace_clients |
    [ $workspace_clients[] | select(.floating == false) ] as $tiled |
    (if ($tiled | length) == 2 and
        all($tiled[]; .mapped == true and .hidden != true and (grouped | not)) then
       ($tiled | map(select(.address == $address)) | .[0]) as $a |
       ($tiled | map(select(.address != $address)) | .[0]) as $b |
       if $a != null and $b != null and x_pair($a; $b) and (y_pair($a; $b) | not) then
         {orientation: "x", peer: $b.address}
       elif $a != null and $b != null and y_pair($a; $b) and (x_pair($a; $b) | not) then
         {orientation: "y", peer: $b.address}
       else null end
     else null end) as $pair |
    if $pair != null and
       (($pair.orientation == "x" and ($direction == "u" or $direction == "d")) or
        ($pair.orientation == "y" and ($direction == "l" or $direction == "r"))) then
      {action: "pair", peer: $pair.peer}
    else
      ($active.at[0]) as $ax0 | ($active.at[0] + $active.size[0]) as $ax1 |
      ($active.at[1]) as $ay0 | ($active.at[1] + $active.size[1]) as $ay1 |
      ($active.at[0] + ($active.size[0] / 2)) as $cx |
      ($active.at[1] + ($active.size[1] / 2)) as $cy |
      [ .[] | select(.address != $address and .mapped == true and .hidden != true
          and .workspace.id == $workspace_id)
        | (.at[0]) as $nx0 | (.at[0] + .size[0]) as $nx1
        | (.at[1]) as $ny0 | (.at[1] + .size[1]) as $ny1
        | ($nx0 + (.size[0] / 2)) as $nx
        | ($ny0 + (.size[1] / 2)) as $ny
        | select(if $direction == "l" then $nx < $cx
                 elif $direction == "r" then $nx > $cx
                 elif $direction == "u" then $ny < $cy
                 else $ny > $cy end)
        | (if $direction == "l" or $direction == "r"
           then ([0, ($ay0 - $ny1), ($ny0 - $ay1)] | max)
           else ([0, ($ax0 - $nx1), ($nx0 - $ax1)] | max) end) as $perpendicular_gap
        | (if $direction == "l" or $direction == "r"
           then ([0, ($ax0 - $nx1), ($nx0 - $ax1)] | max)
           else ([0, ($ay0 - $ny1), ($ny0 - $ay1)] | max) end) as $axis_gap
        | (if $direction == "l" or $direction == "r"
           then ([0, ([ $ay1, $ny1 ] | min) - ([ $ay0, $ny0 ] | max)] | max)
           else ([0, ([ $ax1, $nx1 ] | min) - ([ $ax0, $nx0 ] | max)] | max) end) as $overlap
        | {address, grouped: grouped, aligned: ($overlap > 0), axis_gap: $axis_gap, perpendicular_gap: $perpendicular_gap}
      ] | sort_by([if .aligned then 0 else 1 end, .axis_gap, .perpendicular_gap, .address]) | .[0] // null
      | if . == null then {action: "none"} elif .grouped then {action: "into"} else {action: "swap"} end
    end
  end
' <<<"$clients") || decision='{"action":"none"}'

action=$(jq -r '.action' <<<"$decision")
if [[ $mode == plain && $action != pair ]]; then
    plain_move
    exit $?
fi

pair_state() {
    local current_clients
    current_clients=$(hyprctl -j clients 2>/dev/null) || return 1
    jq -cer --arg active "$active_address" --arg peer "$peer_address" \
        --argjson workspace "$initial_workspace" --arg direction "$direction" '
      def grouped: ((.grouped // []) | length) > 0 or (.group != null);
      def x_pair($a; $b):
        (($a.at[0] + $a.size[0] <= $b.at[0]) or ($b.at[0] + $b.size[0] <= $a.at[0])) and
        ([ $a.at[1], $b.at[1] ] | max) < ([ $a.at[1] + $a.size[1], $b.at[1] + $b.size[1] ] | min);
      def y_pair($a; $b):
        (($a.at[1] + $a.size[1] <= $b.at[1]) or ($b.at[1] + $b.size[1] <= $a.at[1])) and
        ([ $a.at[0], $b.at[0] ] | max) < ([ $a.at[0] + $a.size[0], $b.at[0] + $b.size[0] ] | min);
      [ .[] | select(.workspace.id == $workspace and .floating == false) ] as $tiled |
      if ($tiled | length) != 2 or
         (any($tiled[]; .mapped != true or .hidden == true or grouped)) then
        error("pair became ambiguous")
      else
        ($tiled[] | select(.address == $active)) as $a |
        ($tiled[] | select(.address == $peer)) as $b |
        if x_pair($a; $b) and (y_pair($a; $b) | not) then
          {orientation: "x", side: (if $direction == "l" then ($a.at[0] + $a.size[0]/2 < $b.at[0] + $b.size[0]/2) elif $direction == "r" then ($a.at[0] + $a.size[0]/2 > $b.at[0] + $b.size[0]/2) elif $direction == "u" then ($a.at[1] + $a.size[1]/2 < $b.at[1] + $b.size[1]/2) else ($a.at[1] + $a.size[1]/2 > $b.at[1] + $b.size[1]/2) end)}
        elif y_pair($a; $b) and (x_pair($a; $b) | not) then
          {orientation: "y", side: (if $direction == "l" then ($a.at[0] + $a.size[0]/2 < $b.at[0] + $b.size[0]/2) elif $direction == "r" then ($a.at[0] + $a.size[0]/2 > $b.at[0] + $b.size[0]/2) elif $direction == "u" then ($a.at[1] + $a.size[1]/2 < $b.at[1] + $b.size[1]/2) else ($a.at[1] + $a.size[1]/2 > $b.at[1] + $b.size[1]/2) end)}
        else error("pair geometry became ambiguous") end
      end
    ' <<<"$current_clients" 2>/dev/null
}

case $action in
    out)
        hyprctl dispatch 'hl.dsp.window.move({ out_of_group = true })'
        [[ $direction == r ]] || hyprctl dispatch "hl.dsp.window.move({ direction = \"$movement_direction\" })"
        ;;
    into) hyprctl dispatch "hl.dsp.window.move({ into_group = \"$direction\" })" ;;
    swap) swap_window ;;
    none) ;;
    pair)
        active_address=$(jq -r '.address' <<<"$active")
        peer_address=$(jq -r '.peer' <<<"$decision")
        initial_workspace=$(jq -r '.workspace.id' <<<"$active")
        toggle_pair_split

        active_after=$(hyprctl -j activewindow 2>/dev/null) || exit 1
        [[ $(jq -r '.address' <<<"$active_after") == "$active_address" ]] || {
            printf 'sway-group-move: focus changed while reorienting pair\n' >&2
            exit 1
        }
        state=$(pair_state) || {
            printf 'sway-group-move: pair state unavailable after split reorientation\n' >&2
            exit 1
        }
        [[ $(jq -r '.orientation' <<<"$state") == "$expected_orientation" ]] || {
            printf 'sway-group-move: split reorientation did not produce the expected axis\n' >&2
            exit 1
        }
        if [[ $(jq -r '.side' <<<"$state") != true ]]; then
            # Re-read immediately before swap so a newly ambiguous workspace cannot
            # make the directional operation select an unrelated window.
            state=$(pair_state) || {
                printf 'sway-group-move: pair state unavailable before directional placement\n' >&2
                exit 1
            }
            [[ $(jq -r '.orientation' <<<"$state") == "$expected_orientation" ]] || exit 1
            if [[ $(jq -r '.side' <<<"$state") != true ]]; then
                swap_window
                active_after=$(hyprctl -j activewindow 2>/dev/null) || exit 1
                [[ $(jq -r '.address' <<<"$active_after") == "$active_address" ]] || {
                    printf 'sway-group-move: focus changed while placing reoriented pair\n' >&2
                    exit 1
                }
                state=$(pair_state) || {
                    printf 'sway-group-move: pair state unavailable after directional placement\n' >&2
                    exit 1
                }
                [[ $(jq -r '.orientation' <<<"$state") == "$expected_orientation" && $(jq -r '.side' <<<"$state") == true ]] || {
                    printf 'sway-group-move: requested side not reached after directional swap\n' >&2
                    exit 1
                }
            fi
        fi
        ;;
esac
